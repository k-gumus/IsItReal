{
  "name": "isitreal",
  "version": "0.2.0",
  "description": "Bilgi kirliliğine karşı kaynak soy ağacı izleyen doğrulama motoru ve web arayüzü",
  "type": "module",
  "scripts": {
    "start": "tsx src/server/main.ts",
    "demo": "tsx src/server/main.ts --demo",
    "dev": "tsx watch src/server/main.ts",
    "verify": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsc",
    "start:prod": "node dist/server/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
