# Gerçek tarama için gerekli (yoksa uygulama kurgusal demo verisiyle çalışır)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxx

# İsteğe bağlı: IFCN teyit veritabanı (Google Fact Check Tools API)
GOOGLE_FACTCHECK_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxx

# İsteğe bağlı: Crossref'in "polite" havuzu için e-posta (DOI denetimi anahtarsız çalışır)
# CROSSREF_MAILTO=ornek@eposta.com

# İsteğe bağlı ayarlar
# GEMINI_MODEL=gemini-3.8-flash
# TAVILY_SEARCH_DEPTH=advanced   # basic: istek başına 1 kredi, advanced: 2 kredi
# MAX_DEPTH=2                    # birincil kaynak için en fazla atlama sayısı
# LANGUAGE_CODE=tr
# PORT=3000
# HOST=127.0.0.1
# RATE_LIMIT_PER_MINUTE=8
# TRUST_PROXY=0                  # ters vekil (nginx vb.) arkasındaysanız 1
